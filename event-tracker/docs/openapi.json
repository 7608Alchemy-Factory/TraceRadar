  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunInput": {
        "properties": {
          "fixture_batch_id": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "empty"
            ],
            "title": "Fixture Batch Id"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mock",
                  "qwen"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fixture_batch_id"
        ],
        "title": "RunInput"
      },
      "SourceApproval": {
        "properties": {
          "approved_source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Approved Source Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approved_source_ids"
        ],
        "title": "SourceApproval"
      },
      "Topic": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description"
          },
          "notification_preferences": {
            "type": "string",
            "enum": [
              "standard",
              "digest_only"
            ],
            "title": "Notification Preferences",
            "default": "standard"
          },
          "topic_id": {
            "type": "string",
            "title": "Topic Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active"
            ],
            "title": "Status",
            "default": "draft"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description",
          "topic_id",
          "created_at",
          "updated_at"
        ],
        "title": "Topic"
      },
      "TopicInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description"
          },
          "notification_preferences": {
            "type": "string",
            "enum": [
              "standard",
              "digest_only"
            ],
            "title": "Notification Preferences",
            "default": "standard"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "title": "TopicInput"
      },
      "TopicPatch": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "notification_preferences": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "standard",
                  "digest_only"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Notification Preferences"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "TopicPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
