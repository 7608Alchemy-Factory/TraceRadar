  "components": {
    "schemas": {
      "Fact": {
        "properties": {
          "fact": {
            "type": "string",
            "title": "Fact"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fact",
          "evidence_ids"
        ],
        "title": "Fact"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualEvidenceItem": {
        "properties": {
          "external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Id"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "default": ""
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Title"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "ManualEvidenceItem"
      },
      "ModelDiscoveryInput": {
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Base Url"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_url"
        ],
        "title": "ModelDiscoveryInput"
      },
      "ModelSettingsInput": {
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Base Url"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_url",
          "model"
        ],
        "title": "ModelSettingsInput"
      },
      "ReviewResolutionInput": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "dismiss",
              "accept"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Note"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          },
          "current_status": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Status"
          },
          "fact": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Fact"
          },
          "superseded_facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Superseded Facts"
          },
          "update_kind": {
            "type": "string",
            "enum": [
              "fact_added",
              "major_milestone"
            ],
            "title": "Update Kind",
            "default": "fact_added"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "note"
        ],
        "title": "ReviewResolutionInput"
      },
      "RunInput": {
        "properties": {
          "fixture_batch_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Fixture Batch Id",
            "default": "1"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mock",
                  "qwen"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "prefilter_enabled": {
            "type": "boolean",
            "title": "Prefilter Enabled",
            "default": false
          },
          "near_duplicate_enabled": {
            "type": "boolean",
            "title": "Near Duplicate Enabled",
